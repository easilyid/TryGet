<Project Sdk="Microsoft.NET.Sdk">

  <!--
    V1.0 Iter 1 — Samples/Shared csproj。

    用途：跨 Net + Unity 双端共享的业务代码承载层（业务 Aspect / 业务 Module 接口 /
    网络消息 struct 等）。与 ServerProject/MyTryGetFramework.Core 反向引用 Unity 源不同，
    Shared 的源文件物理存在于 Samples/Shared/*.cs。

    Net 端通过 ProjectReference 引用此 csproj。Unity 端通过 asmdef + 物理路径包含
    （V1.0 决定：源引用，不用 plugin DLL），细则见 ADR-0018。

    约束（与 Core 一致）：
    - 不允许 using UnityEngine / Unity.* — 由 dotnet build 强制
    - 仅允许引用 MyTryGetFramework.Core 和标准 .NET 库
    - 业务侧禁止把 UnityEngine 类型放进 INetMessage / Shared Module 接口
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>TryGet.Shared</RootNamespace>
    <AssemblyName>TryGet.Shared</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ServerProject\MyTryGetFramework.Core\MyTryGetFramework.Core.csproj" />
  </ItemGroup>

</Project>
