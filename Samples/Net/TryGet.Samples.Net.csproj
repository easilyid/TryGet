<Project Sdk="Microsoft.NET.Sdk">

  <!--
    V0.6 Iter 10 — Samples/Net 雏形（dotnet console 跑通 V0.6 异步原语 Demo）。

    用途：证明 MyTryGetFramework.Core 在纯 .NET 环境下也能跑出 async TGTask 流程
    （Boot → Login → InGame 三阶段 Procedure 切换），不依赖 UnityEngine。

    依赖路径：通过 ProjectReference 引用 Shadow csproj（反向编译 Core 源码）。
    入口采用 GameLauncher + Entry.Run 静态模式（框架不定义 IEntry interface，见 Samples/Net/Entry.cs）。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TryGet.Samples.Net</RootNamespace>
    <AssemblyName>TryGet.Samples.Net</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ServerProject\MyTryGetFramework.Core\MyTryGetFramework.Core.csproj" />
  </ItemGroup>

  <!-- V0.9.5: 引用 Source Generator 作为 Analyzer，让 Samples/Net 也享受 [Module] 自动注册 -->
  <!-- 生成器源码已迁入框架内 Generators~/（2026/06/13，对标 Unity Netcode Source~ 模式） -->
  <ItemGroup>
    <ProjectReference Include="..\..\MyTryGetFramework\Assets\MyTryGetFramework\Generators~\MyTryGetFramework.SourceGenerator\MyTryGetFramework.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
